# Baked into the build, not read at run time: this is a static export, so these
# values are substituted for their literals while the site is compiled. Changing
# one takes a rebuild.
#
# Everything here is NEXT_PUBLIC_, which means it ends up in the page source. No
# secret belongs in this file. A measurement id identifies a property; it does
# not grant access to one.
#
# A real environment variable set in Cloudflare overrides anything here, so a
# value can be rotated from the dashboard without a commit.

# Google Analytics 4 — https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-5WXREN35KS

# Microsoft Clarity — session recordings and heatmaps. Unset: no script loads.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Search Console and Bing, only needed for the HTML-tag verification method.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
