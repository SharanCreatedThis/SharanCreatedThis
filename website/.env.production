# Baked into the build, not read at run time: this is a static export, so these
# values are substituted for their literals while the site is compiled. Changing
# one takes a rebuild.
#
# Everything here is NEXT_PUBLIC_, which means it ends up in the page source. No
# secret belongs in this file. A measurement id identifies a property; it does
# not grant access to one.
#
# A real environment variable set in Cloudflare overrides anything here, so a
# value can be rotated from the dashboard without a commit.

# Google Analytics 4 — https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-5WXREN35KS

# Microsoft Clarity — session recordings and heatmaps. Unset: no script loads.
NEXT_PUBLIC_CLARITY_ID=ymfvvjj5ij

# IndexNow — proves to Bing and Yandex that URL submissions come from whoever
# controls this domain. Not NEXT_PUBLIC_: the browser never needs it, though it
# is not secret either, since the proof is publishing it at
# https://www.sharancreatedthis.in/ddbcaf092f91e1b55e8e39c6e5d326ef.txt
# Changing it rewrites that file on the next build and deletes the old one.
INDEXNOW_KEY=ddbcaf092f91e1b55e8e39c6e5d326ef

# Neither of these is required and both stay unset.
#
# Google is verified by DNS through the domain provider, which covers the apex,
# www and every subdomain at once and survives a change of host. The meta tag
# below would be a second, redundant proof of one hostname only.
#
# Bing can import the verified property straight from Search Console, which
# needs no tag either. Set it only if that import is not used.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
