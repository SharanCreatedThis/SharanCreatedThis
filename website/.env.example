# Copy to .env.local for development. Nothing here is required: every one of
# these is optional, and an unset value means that integration simply does not
# load rather than breaking anything.
#
# .env.production holds the real values and is committed, because all of these
# are public identifiers that ship in the page source anyway.

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Not NEXT_PUBLIC_: used by scripts, never sent to the browser.
INDEXNOW_KEY=
