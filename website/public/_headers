# Security and indexing defaults for every response.
# X-Frame-Options: the site is never meant to be framed by anyone.
# Permissions-Policy: nothing here uses a camera, microphone or location, so
#   nothing is granted one, including any third-party script that asks.
# HSTS: two years and preloadable, removing the first unprotected request.
# X-Robots-Tag: explicitly indexable, so nothing downstream has to infer it.
#   The 404 page overrides this for itself with its own noindex meta tag.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Robots-Tag: index, follow

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/vision-orbit-*.webp
  Cache-Control: public, max-age=86400

# The Sparkle feeds. Every installed copy of Hangly and Vision reads these, so they
# are served as XML and kept fresh: a long cache here delays every future update by
# however long the edge holds the old copy.
/products/*/appcast.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

# Release archives are immutable — the version is in the file name.
/products/hangly/releases/*
  Cache-Control: public, max-age=31536000, immutable

# Sparkle's release notes, which it renders inside the update dialog. They are
# real HTML at a real URL, so a crawler will find them and index a page of raw
# changelog with no navigation — thin content that competes with the product
# page. Excluded here rather than in the files, which are update infrastructure
# and are never edited.
# Both spellings. Pages 308s the .html form to the extensionless one, and it is
# the extensionless URL a crawler ends up indexing — a rule on the .html alone
# is applied only to the redirect and never reaches the page itself.
/products/vision/release-notes
  X-Robots-Tag: noindex, nofollow

/products/vision/release-notes.html
  X-Robots-Tag: noindex, nofollow

/products/vision/dev/release-notes
  X-Robots-Tag: noindex, nofollow

/products/vision/dev/release-notes.html
  X-Robots-Tag: noindex, nofollow

# Files a crawler or a curious person fetches once, and that change rarely.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/humans.txt
  Cache-Control: public, max-age=86400

# The IndexNow key file. Bing refetches it on every submission to confirm the
# domain is still ours, so it is served as plain text and not cached for long.
/ddbcaf092f91e1b55e8e39c6e5d326ef.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Icons and social cards. Refetched constantly by link unfurlers, each of which
# wants its own copy, and they only change when the brand does.
/og/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/icon.png
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-maskable.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
